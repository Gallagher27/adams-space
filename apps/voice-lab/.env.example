# Google Cloud Text-to-Speech REST API key.
# Keep the real value in .env.local; never commit it.
GOOGLE_TTS_API_KEY=

# Optional override, for example en-US-Studio-M.
GOOGLE_TTS_VOICE=en-US-Chirp3-HD-Achird

# Required before public deployment. Use a long, unique password (12+ chars).
# Keep it only in the hosting provider's secret/environment settings.
VOICE_LAB_ACCESS_PASSWORD=
