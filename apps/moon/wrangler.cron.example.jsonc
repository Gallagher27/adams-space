{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moon-password-rotation",
  "main": "cron/index.js",
  "compatibility_date": "2026-09-01",
  "triggers": {
    "crons": ["5 0 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moon-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
